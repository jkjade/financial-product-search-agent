COMPOSE_PROJECT_NAME=financial-product-agent
POSTGRES_USER=financial_agent
POSTGRES_PASSWORD=financial-agent-local-only
POSTGRES_DB=financial_products
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000

# Phase 3: final answer generation must use HyperCLOVA X.
HCX_API_KEY=
HCX_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
HCX_MODEL=HCX-005
HCX_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=6

# Optional external-document semantic embeddings.
# Structured product filtering/aggregation/ranking does NOT require embeddings.
HCX_EMBEDDING_BASE_URL=https://clovastudio.stream.ntruss.com
HCX_EMBEDDING_MODEL=bge-m3
HCX_EMBEDDING_TIMEOUT_SECONDS=30
