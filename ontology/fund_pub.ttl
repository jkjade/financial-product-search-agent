@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:PublicFund a owl:Class ; rdfs:subClassOf fp:Product ; rdfs:label "공모펀드"@ko .

fp:productTypePublicFund a owl:DatatypeProperty ;
    rdfs:domain fp:PublicFund ; rdfs:range xsd:string ;
    rdfs:comment "상품유형"@ko ;
    fp:column "product_type" .

fp:sourceTablePublicFund a owl:DatatypeProperty ;
