@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:Bond a owl:Class ; rdfs:subClassOf fp:Product ; rdfs:label "채권"@ko .

fp:productTypeDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품유형"@ko ;
    fp:column "product_type" .

fp:sourceTableDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "원본테이블"@ko ;
    fp:column "source_table" .

fp:productIdDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품번호/채권종목번호"@ko ;
    fp:column "product_id" .

fp:productNameDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품명/채권명"@ko ;
    fp:column "pd_nm_domestic_bond" .

fp:shortNameDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품약어명"@ko ;
    fp:column "pd_abrv_nm_domestic_bond" .

fp:issuerOrManagerDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "발행기관/발행자명"@ko ;
    fp:column "pd_pbcm_domestic_bond" .

fp:assetClassDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품중분류명"@ko ;
    fp:column "std_pd_mcls_nm_domestic_bond" .

fp:investmentRegionDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "국가코드: 종목번호 앞 2자리(KR 등)"@ko ;
    fp:column "pd_ctry_cd_domestic_bond" .

fp:currencyDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "통화코드"@ko ;
    fp:column "curr_cd_domestic_bond" .

fp:riskCodeDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품위험등급 원문 코드"@ko ;
    fp:column "pd_risk_gcd_domestic_bond" .

fp:riskNameDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품위험등급명"@ko ;
    fp:column "pd_risk_nm_domestic_bond" .

fp:creditRatingDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "적용신용등급"@ko ;
    fp:column "crd_grd_domestic_bond" .

fp:saleAvailableDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:boolean ;
    rdfs:comment "매수가능수량"@ko ;
    fp:column "buyable_quantity_domestic_bond" .

fp:buyYieldDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "매수수익률/매수금리"@ko ;
    fp:column "buy_yield" .

fp:appliedYieldDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "민평수익률/민평금리"@ko ;
    fp:column "applied_yield" .

fp:pdExgMkt a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "거래구분"@ko ;
    fp:column "pd_exg_mkt" .

fp:sizeAmountDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "발행잔액/발행금액잔액"@ko ;
    fp:column "isu_bal_amt_domestic_bond" .

fp:priceDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "평가일단가/Clean Price 성격"@ko ;
    fp:column "eval_price_domestic_bond" .

fp:dataBaseDateDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "데이터기준일"@ko ;
    fp:column "data_base_date" .

fp:productInfoUpdateDateDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "민평정보 기준일/최근 업데이트 일자"@ko ;
    fp:column "pd_std_info_update_domestic_bond" .

fp:creditRatingBaseDate a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "신용등급 적용일자(등급 미변경 시 과거 일자로 유지될 수 있음)"@ko ;
    fp:column "credit_rating_base_date" .

fp:issueDate a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "발행일자"@ko ;
    fp:column "issue_date" .

fp:maturityDate a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "상환일자(영구채는 1차 콜행사개시일)"@ko ;
    fp:column "maturity_date" .

fp:bdKnd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "예탁원 기준 채권종류명"@ko ;
    fp:column "bd_knd" .

fp:srfcIrt a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "표면이자율/쿠폰금리"@ko ;
    fp:column "srfc_irt" .

fp:corpPretaxYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "법인 세전 투자수익률"@ko ;
    fp:column "corp_pretax_yield" .

fp:corpAfterTaxYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "법인 세후 투자수익률"@ko ;
    fp:column "corp_after_tax_yield" .

fp:afterTaxYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "개인 세후 운용수익률"@ko ;
    fp:column "after_tax_yield" .

fp:prefTaxYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "세금우대 세후 운용수익률"@ko ;
    fp:column "pref_tax_yield" .

fp:avgAnnualTaxYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "세후 연평균수익률"@ko ;
    fp:column "avg_annual_tax_yield" .

fp:depoEquivYield154 a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "예금환산수익률(세율 15.4 기준)"@ko ;
    fp:column "depo_equiv_yield_154" .

fp:remainingDays a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "잔존일수"@ko ;
    fp:column "remaining_days" .

fp:dur a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "듀레이션"@ko ;
    fp:column "dur" .

fp:cov a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "컨벡시티"@ko ;
    fp:column "cov" .

fp:ndyDur a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "익일 듀레이션"@ko ;
    fp:column "ndy_dur" .

fp:ndyCov a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "익일 컨벡시티"@ko ;
    fp:column "ndy_cov" .

fp:dirty a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "이자부단가/Dirty Price"@ko ;
    fp:column "dirty" .

fp:ndyEvalPrice a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "익일 평가일단가"@ko ;
    fp:column "ndy_eval_price" .

fp:ndyAppliedYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "익일 민평수익률/민평금리"@ko ;
    fp:column "ndy_applied_yield" .

fp:ndyDirty a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "익일 이자부단가"@ko ;
    fp:column "ndy_dirty" .

fp:stdPdSclsNm a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "상품소분류명"@ko ;
    fp:column "std_pd_scls_nm" .

fp:isPensionTradableDomesticBond a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "퇴직연금 편입 가능 여부"@ko ;
    fp:column "pd_pen_tr_yn_domestic_bond" .

fp:bdbnsAblChnlNm a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "채권매매가능채널구분명"@ko ;
    fp:column "bdbns_abl_chnl_nm" .

fp:bdbnsAblChnlTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "채권매매가능채널구분코드"@ko ;
    fp:column "bdbns_abl_chnl_tcd" .

fp:bdInrtTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "금리구분"@ko ;
    fp:column "bd_inrt_tcd" .

fp:bdIntpTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "이자지급구분"@ko ;
    fp:column "bd_intp_tcd" .

fp:bdOfrTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "모집구분"@ko ;
    fp:column "bd_ofr_tcd" .

fp:bdTisuA a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "총발행금액"@ko ;
    fp:column "bd_tisu_a" .

fp:depoEquivYield495 a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "은행환산수익률(세율 49.5 기준)"@ko ;
    fp:column "depo_equiv_yield_495" .

fp:exgClosePrice a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "장내 채권종가"@ko ;
    fp:column "exg_close_price" .

fp:exgClosePriceBaseDt a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "장내 채권종가/종가수익률 기준일"@ko ;
    fp:column "exg_close_price_base_dt" .

fp:exgCloseYield a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "장내 종가수익률"@ko ;
    fp:column "exg_close_yield" .

fp:exrtGrteErnR a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "만기보장수익률"@ko ;
    fp:column "exrt_grte_ern_r" .

fp:exrtGrteErnRTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:string ;
    rdfs:comment "만기보장수익률구분코드"@ko ;
    fp:column "exrt_grte_ern_r_tcd" .

fp:exrtRpyR a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "만기상환율"@ko ;
    fp:column "exrt_rpy_r" .

fp:infoBaseDt a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "판매/민평 공통 기준일"@ko ;
    fp:column "info_base_dt" .

fp:infoSeq a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "동일 종목/시장/기준일 내 판매 LOT 구분 순번"@ko ;
    fp:column "info_seq" .

fp:saleYieldBaseDt a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:date ;
    rdfs:comment "판매수익률 기준일"@ko ;
    fp:column "sale_yield_base_dt" .

fp:tradePrice a owl:DatatypeProperty ;
    rdfs:domain fp:Bond ; rdfs:range xsd:decimal ;
    rdfs:comment "매매단가(표준투입단가)"@ko ;
    fp:column "trade_price" .
