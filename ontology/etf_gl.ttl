@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:OverseasETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "해외 ETF"@ko .

fp:productTypeOverseasEtf a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:string ;
    rdfs:comment "상품유형"@ko ;
    fp:column "product_type" .

fp:sourceTableOverseasEtf a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:string ;
    rdfs:comment "원본테이블"@ko ;
    fp:column "source_table" .

