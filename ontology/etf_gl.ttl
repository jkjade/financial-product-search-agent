@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:OverseasETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "해외 ETF"@ko .

fp:issuerOrManager a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:string ;
    rdfs:label "운용사"@ko ;
    fp:column "issuer_or_manager" ;
    fp:alias "운용사", "자산운용사", "발행사", "issuer", "asset manager", "manager" .

fp:baseIndex a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:string ;
    rdfs:label "기초지수"@ko ;
    fp:column "base_index" ;
    fp:alias "기초지수", "벤치마크", "추종지수", "index", "benchmark" .

fp:feeRate a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:decimal ;
    rdfs:label "보수"@ko ;
    fp:column "fee_rate" ;
    fp:alias "보수", "보수율", "운용보수", "fee", "expense ratio" .

fp:return1d a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:decimal ;
    rdfs:label "return_1d"@en ;
    fp:column "return_1d" .

fp:price a owl:DatatypeProperty ;
    rdfs:domain fp:OverseasETF ; rdfs:range xsd:decimal ;
    rdfs:label "가격"@ko ;
    fp:column "price" ;
    fp:alias "가격", "종가", "평가가격", "price" .

