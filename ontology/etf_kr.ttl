@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:DomesticETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "국내 ETF"@ko .

fp:productTypeDomesticEtf a owl:DatatypeProperty ;
