    rdfs:label "market_data_update_date"@en ;
    rdfs:comment "일간갱신일자"@ko ;
    fp:column "market_data_update_date" .

fp:weeklyDataUpdateDate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:date ;
    rdfs:label "weekly_data_update_date"@en ;
    rdfs:comment "주간갱신일자"@ko ;
    fp:column "weekly_data_update_date" .

fp:listingDate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:date ;
    rdfs:label "listing_date"@en ;
    rdfs:comment "상품거래가능일자"@ko ;
    fp:column "listing_date" .

fp:tradeEndDate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:date ;
    rdfs:label "trade_end_date"@en ;
    rdfs:comment "상품거래종료일자"@ko ;
    fp:column "trade_end_date" .

fp:leverageFactor a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "leverage_factor"@en ;
    rdfs:comment "배수"@ko ;
    fp:column "leverage_factor" .

fp:basePrice a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "base_price"@en ;
    rdfs:comment "기준가"@ko ;
    fp:column "base_price" .

fp:dayHigh a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "day_high"@en ;
    rdfs:comment "고가"@ko ;
