    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "exchange_name"@en ;
    rdfs:comment "거래소명"@ko ;
    fp:column "exchange_name" .

fp:marketName a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "market_name"@en ;
