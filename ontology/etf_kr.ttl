    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "circulating_net_asset_amount"@en ;
    rdfs:comment "유통순자산총액"@ko ;
    fp:column "circulating_net_asset_amount" .

fp:circulatingShareCount a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "circulating_share_count"@en ;
    rdfs:comment "유통주식수"@ko ;
    fp:column "circulating_share_count" .

fp:dividendPerShare a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "dividend_per_share"@en ;
    rdfs:comment "주당 분배금(원천 우선, 없으면 회당 추정)"@ko ;
    fp:column "dividend_per_share" .

fp:dividendYield a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "dividend_yield"@en ;
    rdfs:comment "연환산 분배수익률"@ko ;
    fp:column "dividend_yield" .

