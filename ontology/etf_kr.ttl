    rdfs:comment "연금거래가능여부"@ko ;
    fp:column "is_pension_tradable" .

fp:etfSectorCode a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "etf_sector_code"@en ;
    rdfs:comment "ETF 섹터코드"@ko ;
    fp:column "etf_sector_code" .

fp:isSpac a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "is_spac"@en ;
    rdfs:comment "SPAC 여부"@ko ;
    fp:column "is_spac" .

