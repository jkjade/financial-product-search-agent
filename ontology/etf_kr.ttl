@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:DomesticETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "국내 ETF"@ko .

fp:issuerOrManager a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "운용사"@ko ;
    rdfs:comment "운용사"@ko ;
    fp:column "issuer_or_manager" ;
    fp:alias "운용사", "자산운용사", "발행사", "issuer", "asset manager", "manager" .

fp:riskCode a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "risk_code"@en ;
    rdfs:comment "상품등급코드"@ko ;
    fp:column "risk_code" .

fp:riskName a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "위험등급"@ko ;
    rdfs:comment "상품등급명"@ko ;
    fp:column "risk_name" ;
    fp:alias "위험등급", "위험 등급", "신용등급", "신용 등급", "risk grade", "credit rating" .

fp:baseIndex a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "기초지수"@ko ;
    rdfs:comment "기초지수"@ko ;
    fp:column "base_index" ;
    fp:alias "기초지수", "벤치마크", "추종지수", "index", "benchmark" .

fp:feeRate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "보수"@ko ;
    rdfs:comment "총보수요율"@ko ;
    fp:column "fee_rate" ;
    fp:alias "보수", "보수율", "운용보수", "fee", "expense ratio" .

fp:otherFeeRate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "other_fee_rate"@en ;
    rdfs:comment "기타비용요율"@ko ;
    fp:column "other_fee_rate" .

fp:return1d a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "return_1d"@en ;
    rdfs:comment "수익률_1D"@ko ;
    fp:column "return_1d" .

fp:return1m a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "return_1m"@en ;
    rdfs:comment "수익률_1M"@ko ;
    fp:column "return_1m" .

fp:return3m a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "return_3m"@en ;
    rdfs:comment "수익률_3M"@ko ;
    fp:column "return_3m" .

fp:return6m a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "return_6m"@en ;
    rdfs:comment "수익률_6M"@ko ;
    fp:column "return_6m" .

fp:return1y a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "1년수익률"@ko ;
    rdfs:comment "수익률_1Y"@ko ;
    fp:column "return_1y" ;
    fp:alias "1년수익률", "1년 수익률", "1y return", "one year return" .

fp:returnYtd a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "연초대비"@ko ;
    rdfs:comment "수익률_YTD"@ko ;
    fp:column "return_ytd" ;
    fp:alias "ytd", "연초대비", "연초 대비", "연초 이후 수익률" .

fp:price a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "가격"@ko ;
    rdfs:comment "종가 / 현재가"@ko ;
    fp:column "price" ;
    fp:alias "가격", "종가", "평가가격", "price" .

fp:productInfoUpdateDate a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:date ;
    rdfs:label "product_info_update_date"@en ;
    rdfs:comment "변동갱신일자"@ko ;
    fp:column "product_info_update_date" .

