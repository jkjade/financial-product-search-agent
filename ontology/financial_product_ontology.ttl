@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/financial-product-agent/ontology> a owl:Ontology ;
    rdfs:label "Financial Product Agent Ontology"@en ;
    rdfs:comment "Ontology for the four supplied financial-product datasets. Runtime facts are grounded in the 2026-07-11 dataset snapshot; missing facts must not be inferred as values."@en .

fp:FinancialProduct a owl:Class ; rdfs:label "금융상품"@ko .
fp:Bond a owl:Class ; rdfs:subClassOf fp:FinancialProduct ; rdfs:label "채권"@ko .
fp:ETF a owl:Class ; rdfs:subClassOf fp:FinancialProduct ; rdfs:label "ETF"@ko .
fp:DomesticETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "국내 ETF"@ko .
fp:OverseasETF a owl:Class ; rdfs:subClassOf fp:ETF ; rdfs:label "해외 ETF"@ko .
fp:PublicFund a owl:Class ; rdfs:subClassOf fp:FinancialProduct ; rdfs:label "공모펀드"@ko .
fp:AssetManager a owl:Class ; rdfs:label "운용사/발행사"@ko .
fp:AssetClass a owl:Class ; rdfs:label "자산군"@ko .
fp:InvestmentRegion a owl:Class ; rdfs:label "투자지역"@ko .
fp:Currency a owl:Class ; rdfs:label "통화"@ko .
fp:RiskGrade a owl:Class ; rdfs:label "위험/신용등급"@ko .
fp:BenchmarkIndex a owl:Class ; rdfs:label "기초지수/벤치마크"@ko .
fp:ExternalDocument a owl:Class ; rdfs:label "외부 근거 문서"@ko .
fp:ConstituentSecurity a owl:Class ; rdfs:label "ETF 구성종목"@ko .

fp:managedBy a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:AssetManager ;
    rdfs:label "운용/발행 주체"@ko .
fp:manages a owl:ObjectProperty ;
    owl:inverseOf fp:managedBy ; rdfs:domain fp:AssetManager ; rdfs:range fp:FinancialProduct ;
    rdfs:label "운용/발행하는 상품"@ko .
fp:hasAssetClass a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:AssetClass ; rdfs:label "자산군"@ko .
fp:investsInRegion a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:InvestmentRegion ; rdfs:label "투자지역"@ko .
fp:denominatedIn a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:Currency ; rdfs:label "표시통화"@ko .
fp:hasRiskGrade a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:RiskGrade ; rdfs:label "위험/신용등급"@ko .
fp:tracksIndex a owl:ObjectProperty ;
    rdfs:domain fp:FinancialProduct ; rdfs:range fp:BenchmarkIndex ; rdfs:label "추종 지수/벤치마크"@ko .
fp:holdsSecurity a owl:ObjectProperty ;
    rdfs:domain fp:ETF ; rdfs:range fp:ConstituentSecurity ; rdfs:label "구성종목으로 보유"@ko .
fp:heldBy a owl:ObjectProperty ;
    owl:inverseOf fp:holdsSecurity ; rdfs:domain fp:ConstituentSecurity ; rdfs:range fp:ETF ; rdfs:label "편입된 ETF"@ko .

fp:productId a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:string ; rdfs:label "상품 ID"@ko .
fp:feeRate a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "보수율"@ko .
fp:return1Y a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "1년 수익률"@ko .
fp:returnYTD a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "YTD 수익률"@ko .
fp:yieldRate a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "수익률/금리"@ko .
fp:sizeAmount a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "AUM/규모"@ko .
fp:price a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:decimal ; rdfs:label "가격"@ko .
fp:dataSnapshotDate a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:date ; rdfs:label "데이터 기준일"@ko .
fp:evidenceSource a owl:DatatypeProperty ; rdfs:domain fp:FinancialProduct ; rdfs:range xsd:string ; rdfs:label "근거 출처"@ko .

# Business semantics used by the runtime router/validator.
fp:HigherAUM a owl:Class ; rdfs:label "AUM가 큰"@ko .
fp:LowerFee a owl:Class ; rdfs:label "보수가 낮은"@ko .
fp:HigherReturn a owl:Class ; rdfs:label "수익률이 높은"@ko .
fp:Snapshot20260711 a fp:ExternalDocument ;
    rdfs:label "평가 기준일 2026-07-11"@ko .
