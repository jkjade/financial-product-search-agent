@prefix fp: <https://example.org/financial-product-agent/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


fp:Product a owl:Class ; rdfs:label "금융상품"@ko ;
    rdfs:comment "네 도메인 파일(bond_kr/etf_kr/etf_gl/fund_pub)의 공통 상위 클래스."@ko .
fp:ETF a owl:Class ; rdfs:subClassOf fp:Product ; rdfs:label "ETF"@ko .

fp:Bond a owl:Class ; rdfs:subClassOf fp:Product ;
    rdfs:label "채권"@ko ;
    fp:alias "국내채권", "국내 채권", "채권", "bond" ;
    fp:productType "DOMESTIC_BOND" .
fp:DomesticETF a owl:Class ; rdfs:subClassOf fp:ETF ;
    rdfs:label "국내 ETF"@ko ;
    fp:alias "국내etf", "국내 etf", "한국 etf", "domestic etf" ;
    fp:productType "DOMESTIC_ETF" .
fp:OverseasETF a owl:Class ; rdfs:subClassOf fp:ETF ;
    rdfs:label "해외 ETF"@ko ;
    fp:alias "해외etf", "해외 etf", "미국 etf", "overseas etf", "foreign etf" ;
    fp:productType "OVERSEAS_ETF" .
fp:PublicFund a owl:Class ; rdfs:subClassOf fp:Product ;
    rdfs:label "공모펀드"@ko ;
    fp:alias "공모펀드", "공모 펀드", "펀드", "public fund" ;
    fp:productType "PUBLIC_FUND" .

fp:AssetManager a owl:Class ; rdfs:label "운용사/발행사"@ko .
fp:AssetClass a owl:Class ; rdfs:label "자산군"@ko .
fp:InvestmentRegion a owl:Class ; rdfs:label "투자지역"@ko .
fp:Currency a owl:Class ; rdfs:label "통화"@ko .
fp:RiskGrade a owl:Class ; rdfs:label "위험/신용등급"@ko .
fp:BenchmarkIndex a owl:Class ; rdfs:label "기초지수/벤치마크"@ko .
fp:ExternalDocument a owl:Class ; rdfs:label "외부 근거 문서"@ko .
fp:ConstituentSecurity a owl:Class ; rdfs:label "ETF 구성종목"@ko .

fp:managedBy a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:AssetManager ;
    rdfs:label "운용/발행 주체"@ko ;
    fp:alias "운용하는", "운용사", "발행한", "managed by", "issued by" .
fp:manages a owl:ObjectProperty ;
    owl:inverseOf fp:managedBy ;
    rdfs:domain fp:AssetManager ; rdfs:range fp:Product ;
    rdfs:label "운용/발행하는 상품"@ko ;
    fp:alias "운용 상품", "운용하는 상품", "manages" .
fp:hasAssetClass a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:AssetClass ;
    rdfs:label "자산군"@ko ;
    fp:alias "자산군", "투자자산", "has asset class" .
fp:investsInRegion a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:InvestmentRegion ;
    rdfs:label "투자지역"@ko ;
    fp:alias "투자지역", "투자하는 지역", "invests in" .
fp:denominatedIn a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:Currency ;
    rdfs:label "표시통화"@ko ;
    fp:alias "통화", "표시통화", "denominated in" .
fp:hasRiskGrade a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:RiskGrade ;
    rdfs:label "위험/신용등급"@ko ;
    fp:alias "위험등급", "신용등급", "has risk grade" .
fp:tracksIndex a owl:ObjectProperty ;
    rdfs:domain fp:Product ; rdfs:range fp:BenchmarkIndex ;
    rdfs:label "추종 지수/벤치마크"@ko ;
    fp:alias "추종", "기초지수", "벤치마크", "tracks index" .
fp:holdsSecurity a owl:ObjectProperty ;
    rdfs:domain fp:ETF ; rdfs:range fp:ConstituentSecurity ;
    rdfs:label "구성종목으로 보유"@ko ;
    fp:alias "구성종목", "편입종목", "보유종목", "holds", "contains security" .
fp:heldBy a owl:ObjectProperty ;
    owl:inverseOf fp:holdsSecurity ;
    rdfs:domain fp:ConstituentSecurity ; rdfs:range fp:ETF ;
    rdfs:label "편입된 ETF"@ko ;
    fp:alias "편입한 etf", "포함하는 etf", "held by" .

fp:RankingSemantic a owl:Class .
fp:rankingSemantic1 a fp:RankingSemantic ;
    fp:column "fee_rate" ; fp:order "asc" ;
    fp:alias "보수가 낮은", "보수 낮은", "저보수" .
fp:rankingSemantic2 a fp:RankingSemantic ;
    fp:column "size_amount" ; fp:order "desc" ;
    fp:alias "aum 큰", "aum가 큰", "규모가 큰", "순자산이 큰", "aum가 크", "규모가 크", "순자산이 크" .
fp:rankingSemantic3 a fp:RankingSemantic ;
    fp:column "return_1y" ; fp:order "desc" ;
    fp:alias "수익률 높은", "1년 수익률 높은" .
fp:rankingSemantic4 a fp:RankingSemantic ;
    fp:column "return_1y" ; fp:order "asc" ;
    fp:alias "수익률 낮은", "1년 수익률 낮은" .

fp:sourceTable a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "source_table"@en ;
    fp:column "source_table" .

fp:productId a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "product_id"@en ;
    rdfs:comment "상품번호/채권종목번호"@ko ;
    fp:column "product_id" .

fp:productName a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "product_name"@en ;
    rdfs:comment "상품명/채권명"@ko ;
    fp:column "product_name" .

fp:shortName a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "short_name"@en ;
    rdfs:comment "상품약어명"@ko ;
    fp:column "short_name" .

fp:assetClass a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "자산군"@ko ;
    rdfs:comment "상품중분류명"@ko ;
    fp:column "asset_class" ;
    fp:alias "자산군", "자산 유형", "asset class" .

fp:investmentRegion a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "투자지역"@ko ;
    rdfs:comment "국가코드: 종목번호 앞 2자리(KR 등)"@ko ;
    fp:column "investment_region" ;
    fp:alias "투자지역", "지역", "국가", "investment region", "region" .

fp:currency a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "통화"@ko ;
    rdfs:comment "통화코드"@ko ;
    fp:column "currency" ;
    fp:alias "통화", "표시통화", "currency" .

fp:saleAvailable a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:boolean ;
    rdfs:label "sale_available"@en ;
    fp:column "sale_available" .

fp:sizeAmount a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:decimal ;
    rdfs:label "순자산"@ko ;
    rdfs:comment "펀드/ETF에서는 순자산총액(AUM), 채권에서는 발행잔액을 의미. issue_amount 같은 필드는 없음."@ko ;
    fp:column "size_amount" ;
    fp:alias "aum", "순자산", "순자산총액", "규모", "자산규모", "size", "발행잔액", "발행 잔액", "발행총액", "발행 총액", "채권잔액", "채권 잔액" .

fp:dataBaseDate a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:date ;
    rdfs:label "data_base_date"@en ;
    fp:column "data_base_date" .

fp:returnBaseDate a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:date ;
    rdfs:label "return_base_date"@en ;
    fp:column "return_base_date" .

fp:intradayPremiumDiscountRate a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:decimal ;
    rdfs:label "intraday_premium_discount_rate"@en ;
    fp:column "intraday_premium_discount_rate" .

fp:intradayInav a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:decimal ;
    rdfs:label "intraday_inav"@en ;
    fp:column "intraday_inav" .

fp:dividendCycle a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "dividend_cycle"@en ;
    rdfs:comment "분배주기(A/Q/M/S)"@ko ;
    fp:column "pd_dvid_cycl" .

fp:etfSector a owl:DatatypeProperty ;
    rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "etf_sector"@en ;
    fp:column "etf_sector" .
